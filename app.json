{
  "expo": {
    "name": "Dekati",
    "slug": "dekatip-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "dekati",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#00A859",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00A859"
      },
      "package": "id.desa.dekati.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Aplikasi Dekati membutuhkan izin akses galeri untuk mengunggah berkas persyaratan surat dan foto aduan."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Aplikasi Dekati membutuhkan izin lokasi untuk mendeteksi koordinat titik fasilitas umum yang Anda laporkan."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Aplikasi Dekati membutuhkan izin kamera untuk memindai QR Code pendaftaran desa dan mengambil foto fisik KTP."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
